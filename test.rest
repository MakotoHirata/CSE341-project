@baseUrl = http://localhost:3000
@sessionCookie = paste-connect.sid-cookie-here
@userId = 699a31a4ab7b6e21bb36a7f1
@projectId = 65ff86e2f8e6dbeb0d0f7f11
@taskId = 65ff86e2f8e6dbeb0d0f7f22
@commentId = 65ff86e2f8e6dbeb0d0f7f33

### Health check
GET {{baseUrl}}/

### Start Google OAuth login
GET {{baseUrl}}/auth/google

### Get current user after OAuth login
GET {{baseUrl}}/auth/me
Cookie: connect.sid={{sessionCookie}}

### Get all users
GET {{baseUrl}}/users
Cookie: connect.sid={{sessionCookie}}

### Get one user
GET {{baseUrl}}/users/{{userId}}
Cookie: connect.sid={{sessionCookie}}

### Create project
POST {{baseUrl}}/projects
Content-Type: application/json
Cookie: connect.sid={{sessionCookie}}

{
  "projectName": "Sprint Planning API",
  "description": "Shared project for milestone tracking",
  "ownerId": "{{userId}}",
  "members": ["{{userId}}"]
}

### Update project
PUT {{baseUrl}}/projects/{{projectId}}
Content-Type: application/json
Cookie: connect.sid={{sessionCookie}}

{
  "description": "Updated project description"
}

### Delete project
DELETE {{baseUrl}}/projects/{{projectId}}
Cookie: connect.sid={{sessionCookie}}

### Get all tasks
GET {{baseUrl}}/tasks
Cookie: connect.sid={{sessionCookie}}

### Create task
POST {{baseUrl}}/tasks
Content-Type: application/json
Cookie: connect.sid={{sessionCookie}}

{
  "title": "Implement OAuth callback handling",
  "description": "Complete the Google OAuth login flow",
  "status": "todo",
  "priority": "high",
  "dueDate": "2026-05-01T12:00:00.000Z",
  "projectId": "{{projectId}}",
  "assignedUserId": "{{userId}}"
}

### Update task
PUT {{baseUrl}}/tasks/{{taskId}}
Content-Type: application/json
Cookie: connect.sid={{sessionCookie}}

{
  "status": "in-progress",
  "priority": "medium"
}

### Delete task
DELETE {{baseUrl}}/tasks/{{taskId}}
Cookie: connect.sid={{sessionCookie}}

### Get comments for a task
GET {{baseUrl}}/comments/{{taskId}}
Cookie: connect.sid={{sessionCookie}}

### Create comment
POST {{baseUrl}}/comments
Content-Type: application/json
Cookie: connect.sid={{sessionCookie}}

{
  "taskId": "{{taskId}}",
  "commentText": "I am working on this now."
}

### Update comment
PUT {{baseUrl}}/comments/{{commentId}}
Content-Type: application/json
Cookie: connect.sid={{sessionCookie}}

{
  "commentText": "Updated progress note."
}

### Delete comment
DELETE {{baseUrl}}/comments/{{commentId}}
Cookie: connect.sid={{sessionCookie}}
